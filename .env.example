# SkyN3t 2.0 configuration. Copy to .env and edit. All keys optional —
# with no key or supported local CLI, the system runs fully offline via the stub.

# ---- Paths (checkout defaults are repo-relative; wheels use ~/.skyn3t) ----
# SKYN3T_DATA_DIR=./data
# SKYN3T_PROJECTS_DIR=../Projects
# SKYN3T_LOGS_DIR=./logs

# ---- Web ----
SKYN3T_HOST=127.0.0.1
SKYN3T_PORT=6660
# SKYN3T_AUTH_TOKEN=changeme   # empty => loopback-only

# ---- LLM backend selection ----
# auto: Codex CLI (if installed) -> stub. It never selects OpenRouter or another
# CLI just because a credential/session exists.
# Pin it: stub | openrouter | codex_cli | claude_cli | copilot_cli | kimi_cli
# CLI sign-in and billing stay with the CLI; SkyN3t cannot report exact dollars.
SKYN3T_LLM_BACKEND=auto
# Legacy/manual CLI hint. Automatic builds always use Codex CLI.
SKYN3T_CLI_LLM_PROVIDER=claude
SKYN3T_CLI_LLM_TIMEOUT=180

# Route ONLY codegen to a coding-agent CLI while every other stage stays on the
# global backend (e.g. cheap OpenRouter). Empty = no override. Supported values:
# codex | claude | copilot | kimi. An unavailable explicit choice uses stub only.
SKYN3T_CODEGEN_CLI_PROVIDER=
# Pin which model that CLI runs codegen on (CLI alias like sonnet/opus/fable, or
# a full model id). Empty = the CLI's own default applies.
SKYN3T_CODEGEN_CLI_MODEL=
# Pin OpenRouter whole-project codegen. Empty = route by tier.
SKYN3T_OPENROUTER_CODEGEN_MODEL=
# Optional per-tier OpenRouter model pins. Empty = router defaults.
SKYN3T_MODEL_CHEAP=
SKYN3T_MODEL_UI=
SKYN3T_MODEL_BACKEND=
SKYN3T_MODEL_STRONG=
SKYN3T_MODEL_DOCS=

# ---- LLM API keys (all optional; hosted OpenRouter is explicit opt-in) ----
# SKYN3T_OPENROUTER_API_KEY=sk-or-...
# Set 0 to make SkyN3t ignore both this key and a parent OPENROUTER_API_KEY.
# The Settings dashboard manages this automatically when you disconnect.
# SKYN3T_OPENROUTER_ENABLED=1
# SKYN3T_ANTHROPIC_API_KEY=sk-ant-...
# SKYN3T_OPENAI_API_KEY=sk-...
# SKYN3T_KIMI_API_KEY=...

# ---- Routing policy ----
SKYN3T_FREE_ONLY=1
SKYN3T_NO_CLAUDE=0
SKYN3T_MODEL_EVOLUTION=0      # opt-in: with AUTO_ROUTE, route via the learned ModelTournament leaderboard
SKYN3T_OPENROUTER_MAX_CONCURRENCY=8

# ---- Optional cost/build ceilings ----
# 0 disables each ceiling. The defaults observe usage without limiting output.
SKYN3T_PER_BUILD_USD_CAP=0
SKYN3T_DAILY_USD_CAP=0
SKYN3T_DAILY_TOKEN_CAP=0
SKYN3T_AUTONOMOUS_DAILY_BUILD_CAP=0

# ---- Feature flags ----
SKYN3T_DEBATE_ENABLED=0      # opt-in: `skyn3t debate` runs a full multi-model debate (else single completion)
SKYN3T_REFLECTIVE_RETRY=1
SKYN3T_AUTO_ROUTE=0          # opt-in: gates the learned router; enable together with MODEL_EVOLUTION
SKYN3T_BEST_OF_N=1            # 2.0: trajectory sampling (1=off)
SKYN3T_CRITIC_ENABLED=1       # 2.0: adversarial pre-delivery critic
SKYN3T_VISUAL_SELF_HEAL=0     # 2.0: drive rendered UI (needs browser)
SKYN3T_REWARD_HARDENING=1     # 2.0: anti-reward-hacking on graders

# ---- Game quality (phaser game builds only) ----
# These now default ON. Each one degrades safely: with no vision model / no
# Playwright / no Replicate token it soft-skips BEFORE doing any work ($0, no
# added build time), and only activates the quality pass when the resource exists.
# Set any to 0 to force-disable, even when the resource is present.
SKYN3T_ART_DIRECTOR_ENABLED=1        # LLM tailors a game's roles+palette ($0 on stub)
SKYN3T_GAME_DESIGNER_ENABLED=1       # LLM deepens the game's design spec ($0 on stub)
SKYN3T_GAME_VISUAL_CHECK_ENABLED=1   # screenshot mid-play + vision-judge (needs a vision model)
SKYN3T_GAME_VISUAL_REPAIR_ENABLED=1  # act on the visual check via the improver (needs a vision model)
SKYN3T_QA_PLAYTEST_ENABLED=1         # drive every control in a real browser (needs Playwright)
# Enforcement: turn the (otherwise advisory) visual + QA checks into HARD verdict
# gates for game stacks. When 1, a REAL non-skipped failure (empty play field /
# sprites never render) forces no_go and clamps the score to <=49. A SKIPPED check
# (no vision model / no Playwright) never blocks, so offline builds are unaffected.
# This is the fix for "a broken game still scored go". Set 0 to restore advisory.
SKYN3T_GAME_QUALITY_GATES_VERDICT=1
# Opt-in (default 0): also block a game whose sim exposes neither a reachable win
# NOR lose. Off by default — the reachability probe can't always reach an ending in
# a legit game, so enabling it risks a false no_go.
# SKYN3T_HEADLESS_GATE_REQUIRES_REACHABLE=0
# Vision model for the visual check/repair (empty -> a built-in default; only
# activates for an explicitly selected OpenRouter backend with an enabled key).
# SKYN3T_VISION_MODEL=openai/gpt-4o-mini
# Game role-sprite art: offline (free primitives/CC0) | replicate (paid sprites) | auto.
SKYN3T_GAME_ART_ENABLED=1
SKYN3T_GAME_ART_SOURCE=auto

# ---- Autonomy ----
SKYN3T_AUTONOMOUS_BUILDS=0
SKYN3T_AUTONOMOUS_LEARNING=1
SKYN3T_APPROVAL_GATES=1
SKYN3T_CORTEX_AUTO_APPROVE_SAFE=1

# ---- Sandbox ----
SKYN3T_EXECUTION_BACKEND=auto   # auto | docker | inline
SKYN3T_SANDBOX_HARDENING=1
SKYN3T_SANDBOX_DROP_CAPS=1

# ---- Messaging (optional) ----
# SKYN3T_TELEGRAM_BOT_TOKEN=
# SKYN3T_DISCORD_BOT_TOKEN=
# SKYN3T_SLACK_BOT_TOKEN=
