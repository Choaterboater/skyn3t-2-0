# SkyN3t 2.0 configuration. Copy to .env and edit. All keys optional —
# with none set, the system runs fully offline via the stub LLM backend.

# ---- Paths (defaults are repo-relative) ----
# SKYN3T_DATA_DIR=./data
# SKYN3T_PROJECTS_DIR=../Projects
# SKYN3T_LOGS_DIR=./logs

# ---- Web ----
SKYN3T_HOST=127.0.0.1
SKYN3T_PORT=6660
# SKYN3T_AUTH_TOKEN=changeme   # empty => loopback-only

# ---- LLM backends (OpenRouter is primary) ----
# SKYN3T_OPENROUTER_API_KEY=sk-or-...
# SKYN3T_ANTHROPIC_API_KEY=sk-ant-...
# SKYN3T_OPENAI_API_KEY=sk-...
# SKYN3T_KIMI_API_KEY=...

# ---- Routing policy ----
SKYN3T_FREE_ONLY=1
SKYN3T_NO_CLAUDE=0
SKYN3T_MODEL_EVOLUTION=1
SKYN3T_OPENROUTER_MAX_CONCURRENCY=4

# ---- Cost caps (hard backstops) ----
SKYN3T_PER_BUILD_USD_CAP=0.50
SKYN3T_DAILY_USD_CAP=5.00
SKYN3T_DAILY_TOKEN_CAP=5000000
SKYN3T_AUTONOMOUS_DAILY_BUILD_CAP=10

# ---- Feature flags ----
SKYN3T_DEBATE_ENABLED=0
SKYN3T_REFLECTIVE_RETRY=1
SKYN3T_AUTO_ROUTE=1
SKYN3T_BEST_OF_N=1            # 2.0: trajectory sampling (1=off)
SKYN3T_CRITIC_ENABLED=1       # 2.0: adversarial pre-delivery critic
SKYN3T_VISUAL_SELF_HEAL=0     # 2.0: drive rendered UI (needs browser)
SKYN3T_REWARD_HARDENING=1     # 2.0: anti-reward-hacking on graders

# ---- Autonomy ----
SKYN3T_AUTONOMOUS_BUILDS=0
SKYN3T_AUTONOMOUS_LEARNING=1
SKYN3T_APPROVAL_GATES=1
SKYN3T_CORTEX_AUTO_APPROVE_SAFE=1

# ---- Sandbox ----
SKYN3T_EXECUTION_BACKEND=auto   # auto | docker | inline
SKYN3T_SANDBOX_HARDENING=1
SKYN3T_SANDBOX_DROP_CAPS=1

# ---- Messaging (optional) ----
# SKYN3T_TELEGRAM_BOT_TOKEN=
# SKYN3T_DISCORD_BOT_TOKEN=
# SKYN3T_SLACK_BOT_TOKEN=
